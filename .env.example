# Copy to .env and fill every line without a value. Each secret has its command next to it.

# ---- Sign-in -------------------------------------------------------------------------------
# The administrator account. Password: 12 characters or more.
DOUBLEOH_ADMIN_EMAIL=
DOUBLEOH_ADMIN_PASSWORD=
# openssl rand -base64 48
BETTER_AUTH_SECRET=
# Where people open DoubleOh. Change all four together when you put it behind a domain.
BETTER_AUTH_URL=http://localhost:3001
APP_ORIGIN=http://localhost:3001
FIX_ORIGIN=http://localhost:3001
TRUSTED_ORIGINS=http://localhost:3001

# ---- Secrets -------------------------------------------------------------------------------
# openssl rand -base64 32   Encrypts stored credentials. Losing it orphans them: back it up.
KEY_ENCRYPTION_KEY=
# openssl rand -base64 32   What the server presents to the agent endpoint it manages.
MANAGED_AGENT_TOKEN=

# ---- Models --------------------------------------------------------------------------------
# The skill compiler reads a fix recording with a vision model. A fresh key from console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional, for the built-in chat agents.
OPENAI_API_KEY=

# ---- Rarely changed ------------------------------------------------------------------------
# The AG-UI endpoint for agents created inside the product. Leave it: chat agents are optional and
# a dead address only switches them off.
MANAGED_AGENT_AG_UI_URL=http://localhost:4201/ag-ui
# on: PostgreSQL runs inside the container. off: set DATABASE_URL to your own, with pgvector.
EMBEDDED_POSTGRES=on
# DATABASE_URL=postgres://user:password@host:5432/doubleoh
